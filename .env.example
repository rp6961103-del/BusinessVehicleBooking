APP_ENV=development
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vehicle_booking
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
SECRET_KEY=generate-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
TRUSTED_PROXY_HOPS=0
MAIL_ENABLED=false
# Email provider: google_script (recommended for Render Free) or smtp
EMAIL_PROVIDER=google_script
GOOGLE_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_EMAIL_WEBHOOK_TOKEN=your_webhook_token
# SMTP settings (used only when EMAIL_PROVIDER=smtp)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_DEFAULT_SENDER=BusinessVehicleBooking <no-reply@example.com>


# AI Crop Disease Assistant
# Provider can be: gemini or openai
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30
# Optional for OpenAI-compatible providers
AI_BASE_URL=
